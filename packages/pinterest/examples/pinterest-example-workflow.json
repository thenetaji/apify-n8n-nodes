        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "Pins"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "id"
          ],
          "schema": []
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -60,
        300
      ],
      "id": "d3000000-0000-4000-8000-000000000003",
      "name": "Upsert into the sheet",
      "notes": "Upserts on id, so re-running never duplicates a row.",
      "notesInFlow": true
    },
    {
