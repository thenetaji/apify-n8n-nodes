{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"incremental": true,
		// Must live inside outDir. `n8n-node build` starts with rimraf('dist'), so a
		// cache kept outside it survives the wipe, convinces tsc the outputs are still
		// current, and emits nothing — leaving a dist/ of only the copied SVGs and a
		// node that n8n silently never loads. Keeping it here ties the two together.
		"tsBuildInfoFile": "./dist/.tsbuildinfo",
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json", "package.json"]
}
