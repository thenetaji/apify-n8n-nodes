        "limit": 1,
        "options": {}
      },
      "type": "n8n-nodes-youtube-scraper-apify.youTubeScraper",
      "typeVersion": 1,
      "position": [
        80,
        320
      ],
      "id": "e4000000-0000-4000-8000-000000000004",
      "name": "Get the transcript",
      "notes": "Returns the full transcript as plain text on 'text'.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Summarise this YouTube video for someone deciding whether to watch it.\n\nThree to five bullets on what it actually teaches, then one line on who it is for. No padding, and do not restate the title.\n\nTitle: {{ $('Newest three').item.json.title }}\n\nTranscript:\n{{ $json.text }}",
        "messages": {},
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        340,
        320
      ],
      "id": "e5000000-0000-4000-8000-000000000005",
