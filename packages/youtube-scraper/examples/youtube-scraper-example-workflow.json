        "returnAll": false,
        "limit": 10,
        "options": {}
      },
      "type": "n8n-nodes-youtube-scraper-apify.youTubeScraper",
      "typeVersion": 1,
      "position": [
        -400,
        320
      ],
      "id": "e2000000-0000-4000-8000-000000000002",
      "name": "Fetch latest uploads"
    },
    {
      "parameters": {
        "maxItems": 3
      },
